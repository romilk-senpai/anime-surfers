<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="Hud" src="Screens/Mobile/Hud.uxml" />
    <ui:Template name="MainMenu" src="Screens/Mobile/MainMenu.uxml" />
    <ui:Template name="Pause" src="Screens/Pause.uxml" />
    <ui:Template name="GameOver" src="Screens/GameOver.uxml" />
    <ui:Template name="Settings" src="Screens/Settings.uxml" />
    <ui:Template name="Graphics" src="Screens/Graphics.uxml" />
    <ui:Template name="Shop" src="Screens/Shop.uxml" />
    <ui:VisualElement name="game-ui" class="game-ui" picking-mode="Ignore">
        <ui:Style src="Styles/Common.uss" />
        <ui:Instance template="Hud" name="hud" class="screen" picking-mode="Ignore" />
        <ui:Instance template="MainMenu" name="menu" class="screen" picking-mode="Ignore" />
        <ui:Instance template="Pause" name="pause" class="screen" />
        <ui:Instance template="GameOver" name="game-over" class="screen" />
        <ui:Instance template="Settings" name="settings" class="screen" />
        <ui:Instance template="Graphics" name="graphics" class="screen" />
        <ui:Instance template="Shop" name="shop" class="screen" />
    </ui:VisualElement>
</ui:UXML>
