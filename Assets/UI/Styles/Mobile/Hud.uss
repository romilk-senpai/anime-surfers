/* Touch HUD: pause and power-ups on the left, score stack on the right, nitro button in the bottom corner. */

.hud {
    flex-grow: 1;
}

/* Manga speed lines while the nitro boost is on; opacity follows the boost. */
.speed-lines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    --lines-color: rgba(255, 255, 255, 0.5);
}

.swipe-area {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Margins come from the screen's safe area (GameUi). */
.hud__safe {
    flex-grow: 1;
}

.hud__left {
    position: absolute;
    left: 18px;
    top: 18px;
    align-items: flex-start;
}

.pause-button {
    width: 64px;
    height: 64px;
    border-radius: 32px;
}

.pause-button__bar {
    width: 7px;
    height: 22px;
    margin: 0 3px;
    border-radius: 2px;
    background-color: var(--ink);
}

.power-ups {
    margin-top: 18px;
    margin-left: 5px;
}

.power-up {
    width: 54px;
    height: 54px;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
    --ring-track: #FFFFFF;
    --ring-border: #1C1B4D;
    --ring-thickness: 8;
}

.power-up--magnet {
    --ring-color: #3FA9F5;
}

.power-up--multiplier {
    --ring-color: #FF3D6E;
}

.power-up--shield {
    --ring-color: #8C5CFF;
}

.power-up--super-jump {
    --ring-color: #3DDC84;
}

.power-up--coin-doubler {
    --ring-color: #FFD23F;
}

.power-up--glider {
    --ring-color: #2FC4B2;
}

.power-up__icon {
    width: 20px;
    height: 20px;
    -unity-background-image-tint-color: var(--ink);
}

.power-up__coin {
    width: 24px;
    height: 24px;
}

.power-up__text {
    font-size: 15px;
}

.hud__right {
    position: absolute;
    right: 22px;
    top: 18px;
    align-items: flex-end;
}

.score-panel {
    padding: 2px 20px 4px;
    --panel-shadow: #FFFFFF;
}

/* Dela Gothic digits are proportional: a fixed width (widest score, "444444", is 260px at 46px) keeps it still. */
.score {
    width: 196px;
    font-size: 34px;
    color: var(--paper);
    letter-spacing: 2px;
    -unity-text-align: middle-right;
}

/* On the left: the panel sits against the screen edge. */
.multiplier-sticker {
    position: absolute;
    left: -38px;
    top: -14px;
    rotate: -10deg;
    padding: 5px 9px;
    font-size: 22px;
    color: var(--ink);
    background-color: var(--alarm);
    border-width: 3px;
    border-color: var(--ink);
}

.coins-panel {
    flex-direction: row;
    align-items: center;
    height: 42px;
    margin-top: 12px;
    padding: 0 18px;
    --panel-shadow: #FFD23F;
    --panel-shadow-x: 4;
    --panel-shadow-y: 4;
}

.coins-panel__icon {
    width: 22px;
    height: 22px;
    margin-right: 10px;
}

.coins {
    font-size: 22px;
    color: var(--coin);
}

.distance-panel {
    margin-top: 10px;
    padding: 2px 14px;
    --panel-shadow-x: 0;
    --panel-shadow-y: 0;
}

.distance {
    font-size: 17px;
}

.nitro-button {
    position: absolute;
    right: 24px;
    bottom: 32px;
    width: 128px;
    height: 128px;
    align-items: center;
    justify-content: center;
    --ring-color: #FF8A1F;
    --ring-track: #FFFFFF;
    --ring-border: #1C1B4D;
    --ring-thickness: 16;
    transition-property: scale;
    transition-duration: 0.08s;
}

.nitro-button--active {
    --ring-color: #FF3D6E;
}

.nitro-button--pressed {
    scale: 0.92 0.92;
}

.nitro-button__icon {
    width: 52px;
    height: 52px;
    -unity-background-image-tint-color: var(--ink);
}

/* Barrel ride bar, to the right of the rider: the catch zone the player holds up, the target it has to keep inside,
   and the hold meter beside them. */
.barrel {
    position: absolute;
    left: 64%;
    top: 50%;
    translate: 0 -50%;
    align-items: center;
}

.barrel__time {
    margin-bottom: 8px;
    font-size: 26px;
    color: var(--paper);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--ink);
}

.barrel__body {
    flex-direction: row;
    height: 210px;
}

.barrel__track {
    width: 38px;
    background-color: rgba(28, 27, 77, 0.55);
    border-width: 3px;
    border-color: var(--paper);
    border-radius: 6px;
    overflow: hidden;
}

.barrel__catch {
    position: absolute;
    left: 0;
    right: 0;
    background-color: rgba(63, 169, 245, 0.75);
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--paper);
}

.barrel--catching .barrel__catch {
    background-color: rgba(61, 220, 132, 0.85);
}

.barrel__target {
    position: absolute;
    left: 50%;
    width: 22px;
    height: 22px;
    translate: -50% -50%;
    rotate: 45deg;
    background-color: var(--coin);
    border-width: 3px;
    border-color: var(--ink);
}

.barrel__meter {
    width: 14px;
    margin-left: 8px;
    justify-content: flex-end;
    background-color: rgba(28, 27, 77, 0.55);
    border-width: 3px;
    border-color: var(--paper);
    border-radius: 4px;
    overflow: hidden;
}

.barrel__meter-fill {
    width: 100%;
    background-color: #3DDC84;
}

.barrel--low .barrel__meter-fill {
    background-color: var(--alarm);
}

.barrel__hint {
    margin-top: 10px;
    font-size: 20px;
    color: var(--coin);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--ink);
}

/* Bonus for riding out of the barrel: pops in over the rider, then fades. */
.barrel-result {
    position: absolute;
    left: 0;
    right: 0;
    top: 22%;
    align-items: center;
    opacity: 0;
    scale: 0.6 0.6;
    transition-property: opacity, scale;
    transition-duration: 0.25s, 0.25s;
    transition-timing-function: ease-out-back, ease-out-back;
}

.barrel-result--shown {
    opacity: 1;
    scale: 1 1;
}

.barrel-result__title {
    font-size: 42px;
    color: var(--coin);
    rotate: -6deg;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ink);
}

.barrel-result__bonus {
    font-size: 30px;
    color: var(--paper);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ink);
}
