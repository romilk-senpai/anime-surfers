/* Touch menu: buttons and stats along the top, title and Surf stacked in the middle, katakana strip on the right. */

.menu {
    flex-grow: 1;
}

/* Margins come from the screen's safe area (GameUi); the padding keeps clear of the strip. */
.menu__safe {
    flex-grow: 1;
    padding: 20px 84px 28px 20px;
}

.menu__top {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.menu__corner {
    flex-direction: row;
}

.menu__corner .round-button {
    margin-right: 12px;
}

.menu__stats {
    align-items: flex-end;
}

.stat {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding: 0 20px;
    margin-bottom: 12px;
}

.stat--coins {
    --panel-shadow: #FFD23F;
}

.stat__label {
    font-size: 14px;
    margin-right: 8px;
}

.stat__value {
    font-size: 22px;
}

.stat__value--coins {
    color: var(--coin);
}

.stat__coin {
    width: 24px;
    height: 24px;
    margin-right: 8px;
}

.menu__center {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

/* Vertical katakana down the right edge, one cell per character; runs under the notch on purpose. */
.menu__strip {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 64px;
    background-color: var(--coin);
    border-left-width: 4px;
    border-color: var(--ink);
    align-items: center;
    justify-content: center;
}

.strip__char {
    font-size: 34px;
    height: 40px;
    width: 40px;
    -unity-text-align: middle-center;
    color: var(--ink);
}

/* Long-vowel marks turn upright in vertical text. */
.strip__char--long {
    rotate: 90deg;
}

/* Small kana sit in the top-right of their cell. */
.strip__char--small {
    font-size: 26px;
    translate: 4px -4px;
}

.menu__title {
    align-items: flex-end;
    margin-bottom: 40px;
    rotate: -5deg;
    transition-property: scale;
    transition-duration: 0.6s;
    transition-timing-function: ease-in-out-sine;
}

/* Toggled by MenuPresenter. */
.menu__title--big {
    scale: 1.06 1.06;
}

.title-line {
    font-size: 78px;
    color: var(--paper);
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 7px 7px 0 var(--ink);
}

.title-line--offset {
    margin-top: -14px;
    margin-right: -36px;
}

.menu__surf {
    width: 340px;
    height: 100px;
}

.menu__surf-label {
    font-size: 60px;
}

.menu__surf-icon {
    width: 36px;
    height: 40px;
    margin-right: 20px;
}

.menu__shop {
    margin-top: 22px;
    padding: 0 26px 0 22px;
}

.menu__shop-coin {
    width: 24px;
    height: 24px;
    margin-right: 10px;
}
