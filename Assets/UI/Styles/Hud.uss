.hud {
    flex-grow: 1;
}

/* Manga speed lines while the nitro boost is on; opacity follows the boost. */
.speed-lines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    --lines-color: rgba(255, 255, 255, 0.5);
}

.hud__left {
    position: absolute;
    left: 36px;
    top: 30px;
    align-items: flex-start;
}

.score-panel {
    padding: 4px 28px 6px;
    --panel-shadow: #FFFFFF;
}

/* Dela Gothic digits are proportional: a fixed width (widest score, "444444", is 260px) keeps the panel still. */
.score {
    width: 264px;
    font-size: 46px;
    color: var(--paper);
    letter-spacing: 2px;
    -unity-text-align: middle-left;
}

.multiplier-sticker {
    position: absolute;
    right: -52px;
    top: -16px;
    rotate: 10deg;
    padding: 6px 10px;
    font-size: 26px;
    color: var(--ink);
    background-color: var(--alarm);
    border-width: 3px;
    border-color: var(--ink);
}

.distance-panel {
    margin-top: 12px;
    margin-left: 14px;
    padding: 2px 18px;
    --panel-shadow-x: 0;
    --panel-shadow-y: 0;
}

.distance {
    font-size: 20px;
}

.nitro-panel {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
    margin-left: 6px;
    padding: 6px 18px;
    --panel-shadow: #FFFFFF;
    --panel-shadow-x: 4;
    --panel-shadow-y: 4;
}

.nitro-panel--active {
    --panel-shadow: #FF8A1F;
}

.nitro-panel__label {
    font-size: 16px;
    color: var(--paper);
    margin-right: 12px;
}

.nitro-bar {
    width: 180px;
    height: 14px;
    background-color: var(--paper);
    border-width: 2px;
    border-color: var(--paper);
}

.nitro-bar__fill {
    width: 100%;
    height: 100%;
    background-color: #FF8A1F;
}

.nitro-panel--active .nitro-bar__fill {
    background-color: var(--alarm);
}

.power-ups {
    margin-top: 18px;
}

.power-up {
    width: 60px;
    height: 60px;
    margin-bottom: 14px;
    align-items: center;
    justify-content: center;
    --ring-track: #FFFFFF;
    --ring-border: #1C1B4D;
    --ring-thickness: 8;
}

.power-up--magnet {
    --ring-color: #3FA9F5;
}

.power-up--multiplier {
    --ring-color: #FF3D6E;
}

.power-up--shield {
    --ring-color: #8C5CFF;
}

.power-up--super-jump {
    --ring-color: #3DDC84;
}

.power-up--coin-doubler {
    --ring-color: #FFD23F;
}

.power-up--glider {
    --ring-color: #2FC4B2;
}

.power-up__icon {
    width: 22px;
    height: 22px;
    -unity-background-image-tint-color: var(--ink);
}

.power-up__coin {
    width: 26px;
    height: 26px;
}

.power-up__text {
    font-size: 16px;
}

.hud__right {
    position: absolute;
    right: 36px;
    top: 32px;
    flex-direction: row;
    align-items: center;
}

.coins-panel {
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding: 0 26px;
    margin-right: 22px;
    --panel-shadow: #FFD23F;
}

.coins-panel__icon {
    width: 26px;
    height: 26px;
    margin-right: 12px;
}

.coins {
    font-size: 28px;
    color: var(--coin);
}

.pause-button__bar {
    width: 7px;
    height: 22px;
    margin: 0 3px;
    border-radius: 2px;
    background-color: var(--ink);
}

/* Barrel ride bar, to the right of the rider: the catch zone the player holds up, the target it has to keep inside,
   and the hold meter beside them. */
.barrel {
    position: absolute;
    left: 64%;
    top: 50%;
    translate: 0 -50%;
    align-items: center;
}

.barrel__time {
    margin-bottom: 8px;
    font-size: 34px;
    color: var(--paper);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--ink);
}

.barrel__body {
    flex-direction: row;
    height: 320px;
}

.barrel__track {
    width: 46px;
    background-color: rgba(28, 27, 77, 0.55);
    border-width: 3px;
    border-color: var(--paper);
    border-radius: 6px;
    overflow: hidden;
}

.barrel__catch {
    position: absolute;
    left: 0;
    right: 0;
    background-color: rgba(63, 169, 245, 0.75);
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--paper);
}

.barrel--catching .barrel__catch {
    background-color: rgba(61, 220, 132, 0.85);
}

.barrel__target {
    position: absolute;
    left: 50%;
    width: 26px;
    height: 26px;
    translate: -50% -50%;
    rotate: 45deg;
    background-color: var(--coin);
    border-width: 3px;
    border-color: var(--ink);
}

.barrel__meter {
    width: 16px;
    margin-left: 8px;
    justify-content: flex-end;
    background-color: rgba(28, 27, 77, 0.55);
    border-width: 3px;
    border-color: var(--paper);
    border-radius: 4px;
    overflow: hidden;
}

.barrel__meter-fill {
    width: 100%;
    background-color: #3DDC84;
}

.barrel--low .barrel__meter-fill {
    background-color: var(--alarm);
}

.barrel__hint {
    margin-top: 10px;
    font-size: 26px;
    color: var(--coin);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--ink);
}

/* Bonus for riding out of the barrel: pops in over the rider, then fades. */
.barrel-result {
    position: absolute;
    left: 0;
    right: 0;
    top: 22%;
    align-items: center;
    opacity: 0;
    scale: 0.6 0.6;
    transition-property: opacity, scale;
    transition-duration: 0.25s, 0.25s;
    transition-timing-function: ease-out-back, ease-out-back;
}

.barrel-result--shown {
    opacity: 1;
    scale: 1 1;
}

.barrel-result__title {
    font-size: 56px;
    color: var(--coin);
    rotate: -6deg;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ink);
}

.barrel-result__bonus {
    font-size: 40px;
    color: var(--paper);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ink);
}
